def add(a,b):
    print(a+b)

def add(a,b,c):
    print(a+b+c)

#print(Add(10,20))#error
print(add(10,20,30))

#default values
def add(a,b=0,c=0):
    print(a+b+c)
add(10)
add(10,20)
add(10,20,30)

#*args -0 ----n arguments can be passed
def add(*a):
    print(sum(a))
add(10,20)
add(10,20,30)
add(10)

#**kwargs -keyword arguments
def stu_info(**kwargs):
    print(f"Name is {kwargs.get('name')}", end="")
    print(f"Age is {kwargs.get('age')}", end=" ")
    print(f"Course is {kwargs.get('course')}", end="")

stu_info(name="Kabita",age=23,course="Python")